      {
        "id": "sec_17834149312143",
        "type": "editorial-paragraph",
        "hidden": false,
        "data": {
          "content": {
            "heading": "New Section",
            "italicHeading": "",
            "subheading": "",
            "description": "There is a profound luxury in quietness. In an era defined by perpetual noise and relentless acceleration, the ultimate indulgence is the pause. For the Fall/Winter 2026 collection, Tezhhomayaa journeys into the void, exploring the intersection of brutalist architecture, monastic discipline, and the fluid geometry of the human form.\n\nThis is not merely a collection of garments. It is a meditation on space. It is an inquiry into what remains when everything unnecessary is stripped away. We arrived at the edge of the world to capture a wardrobe designed not to demand attention, but to command presence.",
            "primaryButton": {
              "enabled": true,
              "label": "Explore",
              "url": "#",
              "style": "luxury"
            },
