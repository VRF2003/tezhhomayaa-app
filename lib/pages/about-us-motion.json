    {
      "id": "motion-4-storytelling",
      "type": "motion-storytelling",
      "hidden": false,
      "data": {
        "content": {
          "description": "Tezhhomayaa embodies a bold, revolutionary spirit where creativity and movement merge.\nInspired by the essence of existence, the brand transforms garments into living art.\nEvery creation is a canvas of color and motion, inviting you to break conventions and embrace limitless imagination.\nEach stride, jump, or run becomes a brushstroke in a masterpiece of movement.\nIt is an expression of individuality, creativity, and the art of motion."
        },
        "media": {
          "type": "image",
          "desktop": {
            "url": "/campaign-story.jpg"
          },
          "mobile": {
            "url": "/campaign-story.jpg"
          }
        },
        "style": {
          "backgroundColor": "#000000",
          "textColor": "#ffffff"
        }
      }
    },
