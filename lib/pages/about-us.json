    {
      "id": "manifesto-section",
      "type": "quote-block",
      "hidden": false,
      "data": {
        "content": {
          "heading": "\"Art infused fashion for everyday living\"",
          "subheading": "TEZHHOMAYAA : ARTISTIC REVOLUTION",
          "description": "Tezhhomayaa embodies a bold, revolutionary spirit where creativity and movement merge. Inspired by the essence of existence, the brand transforms garments into living art — a fusion of performance, innovation, and abstract expression. Every creation is a canvas of color and motion, inviting you to break conventions and embrace limitless imagination. Each stride, jump, or run becomes a brushstroke in a masterpiece of movement. Tezhhomayaa celebrates the harmony of artistry and athleticism, empowering you to push boundaries and redefine what’s possible. It’s not just gear — it’s an expression of individuality, creativity, and the art of motion.",
          "primaryButton": {
            "enabled": false,
            "label": "",
            "url": "#",
            "style": "luxury"
          },
